---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Logo from '../assets/logo.svg';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
	{ href: '/', label: 'Proyectos' },
	{ href: '/nosotros', label: 'Nosotros' },
	{ href: '/contacto', label: 'Contacto' },
] as const;
const bgColor = Astro.props.bgColor;

const linkClass =
	'block w-full text-right pr-2 text-voi-black text-base font-libertad-mono border border-transparent hover:border-voi-black';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link
			rel="preload"
			href="/fonts/LibertadMono-Regular.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		/>
		<meta name="generator" content={Astro.generator} />
		<title>Voi Estudio de diseño</title>
		<ClientRouter />
	</head>
	<body>
		<main class={`flex items-center justify-center h-screen  relative overflow-hidden ${bgColor}`}>
			<div class="grid w-full h-full grid-cols-2 mx-8 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-7 gap-4 auto-rows-44">
				<div class="col-span-1 row-span-2 row-start-1 col-start-0 lg:col-start-2  grid grid-cols-subgrid grid-rows-subgrid z-20">
					<div class="col-span-1 row-span-1  flex items-end justify-start">
						<Logo class="w-1/2 text-voi-black text-2xl font-libertad-mono" />
					</div>
					<div class="col-span-1 row-span-1 ">
						<nav>
							<ul class="flex flex-col items-end justify-start ">
								{links.map(({ href, label }) => {
									const isActive = pathname === href;
									return (
										<li class="block w-full text-right">
											<a
												href={href}
												class:list={[linkClass, isActive && 'bg-voi-orange']}
												aria-current={isActive ? 'page' : undefined}
											>
												{label}
											</a>
										</li>
									);
								})}
							</ul>
						</nav>
					</div>
				</div>
				<slot />
			</div>
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: 'LibertadMono', sans-serif;
	}
</style>

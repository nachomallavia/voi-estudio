---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Logo from '../assets/logo.svg';
import Footer from '../components/Footer.astro';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
	{ href: '/', label: 'Proyectos' },
	{ href: '/nosotros', label: 'Nosotros' },
	{ href: '/contacto', label: 'Contacto' },
] as const;
const bgColor = Astro.props.bgColor as string | undefined;

const linkClass =
	'block w-full text-right pr-2 text-current text-base font-libertad-mono border border-transparent hover:border-current transition-[border-color] duration-200 ease-in-out';
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link
			rel="preload"
			href="/fonts/LibertadMono-Regular.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		/>
		<meta name="generator" content={Astro.generator} />
		<title>Voi Estudio de diseño</title>
		<ClientRouter />
	</head>
	<body>
		<main class:list={['relative h-screen overflow-y-auto ', bgColor]}>
			<div class="grid grid-cols-2 gap-4 auto-rows-44 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-7">
				<div
					class="col-span-1 -translate-y-1/4 md:-translate-y-0 row-span-2 row-start-1 col-start-1 lg:col-start-2 z-20 grid grid-cols-subgrid grid-rows-subgrid"
					data-site-brand
					data-nav-theme="dark"
				>
					<div class="col-span-1 row-span-1 flex items-end justify-start pl-5">
						<Logo class="w-1/2 text-2xl font-libertad-mono" />
					</div>
					<div class="col-span-1 row-span-1">
						<nav>
							<ul class="flex flex-col items-end justify-start">
								{links.map(({ href, label }) => {
									const isActive = pathname === href;
									return (
										<li class="block w-full text-right">
											<a
												href={href}
												class:list={[
													linkClass,
													isActive && 'bg-voi-orange !text-voi-black',
												]}
												aria-current={isActive ? 'page' : undefined}
											>
												{label}
											</a>
										</li>
									);
								})}
							</ul>
						</nav>
					</div>
				</div>
				<slot />
			</div>
			<Footer pathname={pathname} links={links} />
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		font-family: 'LibertadMono', sans-serif;
	}
</style>

<script>
	import { startFadeUp } from '../lib/fade-up';
	import { startScrollPersist } from '../lib/scroll-persist';
	startScrollPersist();
	startFadeUp();
</script>

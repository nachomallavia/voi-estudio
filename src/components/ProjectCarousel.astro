---
import { Image } from 'astro:assets';
import type { ProjectView } from '../lib/projects';
import { resolveSlideSlot } from '../lib/carousel-slots';

interface Props {
	projects: ProjectView[];
}

const { projects } = Astro.props;

const proyectoParam = Astro.url.searchParams.get('proyecto');
const detalleParam = Astro.url.searchParams.get('detalle');
const matchedIndex = projects.findIndex((project) => project.id === proyectoParam);
const initialActive = matchedIndex >= 0 ? matchedIndex : 0;
const initialExpanded = detalleParam === '1' || detalleParam === 'true';
---

<section
	class="project-carousel col-span-full row-start-1 z-10 w-full min-w-0 grid grid-cols-subgrid grid-rows-subgrid"
	data-project-carousel
	data-count={projects.length}
	data-collapsed-rows="6"
	data-stage-rows="5"
	data-initial-active={initialActive}
	data-initial-expanded={initialExpanded ? 'true' : 'false'}
	data-expanded={initialExpanded ? 'true' : 'false'}
	data-meta-fill={initialExpanded ? 'true' : 'false'}
	aria-roledescription="carrusel"
	aria-label="Proyectos"
>
	<div
		class="carousel-controls row-start-1 col-span-1 z-20 flex items-end justify-end gap-4"
		data-carousel-controls
	>
<button
	type="button"
	class="carousel-btn"
	data-carousel-prev
	aria-label="Proyecto anterior"
>
	<svg viewBox="0 0 10 16" class="carousel-btn__icon" aria-hidden="true">
		<path d="M8.5 1.5 2 8l6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.2"></path>
	</svg>
</button>
<button
	type="button"
	class="carousel-btn"
	data-carousel-next
	aria-label="Proyecto siguiente"
>
	<svg viewBox="0 0 10 16" class="carousel-btn__icon" aria-hidden="true">
		<path d="M1.5 1.5 8 8l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.2"></path>
	</svg>
</button>
</div>
	<div
		class="carousel-stage relative col-span-full row-span-3  w-full min-w-0 grid grid-cols-subgrid grid-rows-subgrid"
	>
		
		<div class="carousel-track contents" data-carousel-track>
			{
				projects.map((project, index) => {
					const slot = resolveSlideSlot(index, initialActive, projects.length);
					return (
						<figure
							class="carousel-slide m-0 min-w-0 min-h-0"
							data-slide
							data-index={index}
							data-slot={slot}
							data-nav-theme={project.data.navTheme}
						>
							<Image
								src={project.data.cover}
								alt={project.data.coverAlt}
								widths={[240, 480, 752, 1264, 1600]}
								sizes="(max-width: 640px) 90vw, (max-width: 1024px) 42vw, 30vw"
								loading={index === initialActive ? 'eager' : 'lazy'}
								fetchpriority={index === initialActive ? 'high' : 'auto'}
								class="carousel-slide__img h-full w-full object-cover"
							/>
						</figure>
					);
				})
			}
		</div>

		
	</div>

	<div
		class="carousel-meta row-span-1 row-start-5 z-40 flex min-w-0 items-start justify-between gap-6"
	>
		<div
			class="min-w-0 font-libertad-mono text-base leading-tight text-voi-black md:text-sm"
			data-carousel-meta
		>
			{
				projects.map((project, index) => (
					<div
						class="carousel-meta__item"
						data-meta
						data-index={index}
						hidden={index !== initialActive}
					>
						<p>
							{project.data.code} // {project.data.category}
						</p>
						<p>{project.data.locality}</p>
						<p>{project.data.region}</p>
					</div>
				))
			}
		</div>

		<button
			type="button"
			class="carousel-cta shrink-0 border border-voi-black px-6 py-4 font-libertad-mono text-lg text-voi-black transition-colors hover:bg-voi-orange hover:text-voi-black active:scale-90 active:bg-voi-black active:text-voi-white active:transition-scale"
			data-carousel-toggle
			aria-expanded={initialExpanded ? 'true' : 'false'}
			aria-controls="project-detail-panel"
		>
			<span data-cta-label>{initialExpanded ? 'OCULTAR DETALLE' : 'VER DETALLE'}</span>
		</button>
	</div>

	<div
		id="project-detail-panel"
		class="project-detail-panel col-span-full grid grid-cols-subgrid grid-rows-subgrid -mt-22 z-30"
		data-detail-panel
		hidden={!initialExpanded}
	>
		{
			projects.map((project, index) => (
				<div
					class="col-span-full grid grid-cols-subgrid grid-rows-subgrid bg-voi-white lg:col-span-5 lg:col-start-2"
					data-detail
					data-index={index}
					data-id={project.id}
					hidden={index !== initialActive}
				>
					<slot name={project.id} />
				</div>
			))
		}
	</div>
</section>

<script is:inline data-astro-rerun>
	(() => {
		const root = document.querySelector('[data-project-carousel]');
		if (!root) return;

		const params = new URLSearchParams(location.search);
		const hasUrlState = params.has('proyecto') || params.has('detalle');
		let stored = null;
		try {
			stored = JSON.parse(sessionStorage.getItem('voi-carousel') || 'null');
		} catch {
			stored = null;
		}

		const proyecto = params.get('proyecto') || (!hasUrlState && stored && stored.proyecto) || null;
		const expanded = hasUrlState
			? params.get('detalle') === '1' || params.get('detalle') === 'true'
			: Boolean(stored && stored.detalle);

		const details = [...root.querySelectorAll('[data-detail]')];
		let active = 0;
		if (proyecto) {
			const match = details.find((item) => item.getAttribute('data-id') === proyecto);
			if (match) active = Number(match.getAttribute('data-index')) || 0;
		}

		root.setAttribute('data-expanded', expanded ? 'true' : 'false');
		root.setAttribute('data-meta-fill', expanded ? 'true' : 'false');
		root.setAttribute('data-initial-active', String(active));
		root.setAttribute('data-initial-expanded', expanded ? 'true' : 'false');

		const panel = root.querySelector('[data-detail-panel]');
		if (panel) panel.hidden = !expanded;

		const toggle = root.querySelector('[data-carousel-toggle]');
		if (toggle) toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');

		const label = root.querySelector('[data-cta-label]');
		if (label) label.textContent = expanded ? 'OCULTAR DETALLE' : 'VER DETALLE';

		for (const item of root.querySelectorAll('[data-meta]')) {
			item.hidden = Number(item.getAttribute('data-index')) !== active;
		}
		for (const item of details) {
			item.hidden = Number(item.getAttribute('data-index')) !== active;
		}
	})();
</script>

<style>
	/* Align to hero's right column; Flip animates the shift on expand/collapse */
	.carousel-controls {
		grid-column-start: 2;
	}

	@media (min-width: 768px) {
		.carousel-controls {
			grid-column-start: 4;
		}
	}

	@media (min-width: 1024px) {
		.carousel-controls {
			grid-column-start: 5;
		}
	}

	@media (min-width: 640px) {
		.project-carousel[data-expanded='true'] .carousel-controls {
			grid-column-start: 3;
		}
	}

	@media (min-width: 768px) {
		.project-carousel[data-expanded='true'] .carousel-controls {
			grid-column-start: 5;
		}
	}

	@media (min-width: 1024px) {
		.project-carousel[data-expanded='true'] .carousel-controls {
			grid-column-start: 6;
		}
	}

	.carousel-stage {
		overflow: hidden;
		/* Match layout auto-rows-44 (11rem) + gap-4 (1rem) */
		--slide-row: 11rem;
		--slide-gap: 1rem;
		--slide-h-far: var(--slide-row);
		--slide-h-mid: calc(var(--slide-row) * 2 + var(--slide-gap));
		--slide-h-hero: calc(var(--slide-row) * 3 + var(--slide-gap) * 2);
		touch-action: pan-y;
		cursor: grab;
		user-select: none;
	}

	.carousel-stage.is-dragging {
		cursor: grabbing;
	}

	.carousel-stage .carousel-controls,
	.carousel-stage .carousel-controls * {
		cursor: pointer;
	}

	.project-carousel[data-expanded='true'] .carousel-stage {
		overflow: visible;
	}

	.carousel-meta {
		padding: 0;
		background-color: transparent;
		/* Stay in-grid under the hero at every breakpoint (2 / 3 / 5 / 7 cols). */
		grid-column: 1 / span 2;
	}

	@media (min-width: 640px) {
		.carousel-meta {
			grid-column: 1 / span 3;
		}
	}

	@media (min-width: 768px) {
		.carousel-meta {
			grid-column: 2 / span 3;
		}
	}

	@media (min-width: 1024px) {
		.carousel-meta {
			grid-column: 3 / span 3;
		}
	}

	/* Background can fade before width collapses; padding stays with expanded width */
	.project-carousel[data-meta-fill='true'] .carousel-meta {
		background-color: var(--color-voi-white);
	}

	.project-carousel[data-expanded='true'] .carousel-meta {
		padding: 1.25rem;
		grid-column: 1 / span 2;
	}

	@media (min-width: 640px) {
		.project-carousel[data-expanded='true'] .carousel-meta {
			grid-column: 1 / span 3;
		}
	}

	@media (min-width: 768px) {
		.project-carousel[data-expanded='true'] .carousel-meta {
			grid-column: 1 / span 5;
		}
	}

	@media (min-width: 1024px) {
		.project-carousel[data-expanded='true'] .carousel-meta {
			grid-column: 2 / span 5;
		}
	}

	.carousel-slide {
		overflow: hidden;
		margin: 0;
		opacity: 0;
		pointer-events: none;
		z-index: 0;
		grid-row: 1 / span 4;
		align-self: center;
		justify-self: stretch;
		width: 100%;
	}

	.carousel-slide[data-slot='hidden-left'],
	.carousel-slide[data-slot='far-left'] {
		grid-column: 1 / span 1;
		height: var(--slide-h-far);
	}

	.carousel-slide[data-slot='hidden-right'],
	.carousel-slide[data-slot='far-right'] {
		grid-column: 2 / span 1;
		height: var(--slide-h-far);
	}

	.carousel-slide[data-slot='mid-left'] {
		grid-column: 1 / span 1;
		height: var(--slide-h-mid);
	}

	.carousel-slide[data-slot='mid-right'] {
		grid-column: 2 / span 1;
		height: var(--slide-h-mid);
	}

	.carousel-slide[data-slot='hero'] {
		grid-column: 1 / span 2;
		height: var(--slide-h-hero);
		z-index: 2;
	}

	.carousel-slide[data-slot='far-left'],
	.carousel-slide[data-slot='far-right'],
	.carousel-slide[data-slot='mid-left'],
	.carousel-slide[data-slot='mid-right'],
	.carousel-slide[data-slot='hero'] {
		opacity: 1;
	}

	/* Buffers park off-stage so enters/exits glide instead of popping.
	   Use the individual `translate` property (not `transform`) so Flip's
	   leftover inline transforms cannot pin buffers back to their grid cell. */
	.carousel-slide[data-slot='hidden-left'],
	.carousel-slide[data-slot='hidden-right'] {
		opacity: 0;
		z-index: 0;
	}

	.carousel-slide[data-slot='hidden-left'] {
		translate: -120% 0;
	}

	.carousel-slide[data-slot='hidden-right'] {
		translate: 120% 0;
	}

	.carousel-slide__img {
		display: block;
		width: 100%;
		height: 100%;
		max-width: 100%;
		max-height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.project-carousel[data-expanded='true'] .carousel-slide[data-slot='hero'] {
		grid-column: 1 / span 2;
		align-self: stretch;
		height: auto;
		z-index: 3;
	}

	.project-carousel[data-expanded='true'] .carousel-slide[data-slot='mid-left'],
	.project-carousel[data-expanded='true'] .carousel-slide[data-slot='mid-right'] {
		z-index: 1;
	}

	.project-carousel[data-expanded='true'] .carousel-slide[data-slot='far-left'],
	.project-carousel[data-expanded='true'] .carousel-slide[data-slot='far-right'] {
		opacity: 0;
	}

	/* sm: 3 columns — mid / hero / mid */
	@media (min-width: 640px) {
		.carousel-slide[data-slot='hidden-left'],
		.carousel-slide[data-slot='far-left'],
		.carousel-slide[data-slot='mid-left'] {
			grid-column: 1 / span 1;
		}

		.carousel-slide[data-slot='hero'] {
			grid-column: 2 / span 1;
		}

		.carousel-slide[data-slot='hidden-right'],
		.carousel-slide[data-slot='far-right'],
		.carousel-slide[data-slot='mid-right'] {
			grid-column: 3 / span 1;
		}

		.project-carousel[data-expanded='true'] .carousel-slide[data-slot='hero'] {
			grid-column: 1 / span 3;
		}

		.project-carousel[data-expanded='true'] .carousel-slide[data-slot='mid-left'] {
			grid-column: 1 / span 1;
		}

		.project-carousel[data-expanded='true'] .carousel-slide[data-slot='mid-right'] {
			grid-column: 3 / span 1;
		}
	}

	/* md: 5 columns — peek / hero×3 / peek */
	@media (min-width: 768px) {
		.carousel-slide[data-slot='hidden-left'],
		.carousel-slide[data-slot='far-left'],
		.carousel-slide[data-slot='mid-left'] {
			grid-column: 1 / span 1;
		}

		.carousel-slide[data-slot='hero'] {
			grid-column: 2 / span 3;
		}

		.carousel-slide[data-slot='hidden-right'],
		.carousel-slide[data-slot='far-right'],
		.carousel-slide[data-slot='mid-right'] {
			grid-column: 5 / span 1;
		}

		.carousel-slide[data-slot='far-left'],
		.carousel-slide[data-slot='far-right'] {
			opacity: 0;
		}

		.project-carousel[data-expanded='true'] .carousel-slide[data-slot='hero'] {
			grid-column: 1 / span 5;
		}

		.project-carousel[data-expanded='true'] .carousel-slide[data-slot='mid-left'] {
			grid-column: 1 / span 1;
		}

		.project-carousel[data-expanded='true'] .carousel-slide[data-slot='mid-right'] {
			grid-column: 5 / span 1;
		}
	}

	/* lg: 7 columns — full strip */
	@media (min-width: 1024px) {
		.carousel-slide[data-slot='hidden-left'],
		.carousel-slide[data-slot='far-left'] {
			grid-column: 1 / span 1;
		}

		.carousel-slide[data-slot='mid-left'] {
			grid-column: 2 / span 1;
		}

		.carousel-slide[data-slot='hero'] {
			grid-column: 3 / span 3;
		}

		.carousel-slide[data-slot='mid-right'] {
			grid-column: 6 / span 1;
		}

		.carousel-slide[data-slot='hidden-right'],
		.carousel-slide[data-slot='far-right'] {
			grid-column: 7 / span 1;
		}

		.carousel-slide[data-slot='far-left'],
		.carousel-slide[data-slot='far-right'] {
			opacity: 1;
		}

		.project-carousel[data-expanded='true'] .carousel-slide[data-slot='hero'] {
			grid-column: 2 / span 5;
		}

		.project-carousel[data-expanded='true'] .carousel-slide[data-slot='mid-left'] {
			grid-column: 1 / span 1;
		}

		.project-carousel[data-expanded='true'] .carousel-slide[data-slot='mid-right'] {
			grid-column: 7 / span 1;
		}

		.project-carousel[data-expanded='true'] .carousel-slide[data-slot='far-left'],
		.project-carousel[data-expanded='true'] .carousel-slide[data-slot='far-right'] {
			opacity: 0;
		}
	}

	.carousel-btn {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border: 1px solid var(--color-voi-black);
		color: var(--color-voi-black);
		background: transparent;
		cursor: pointer;
	}

	.carousel-btn:hover {
		background: var(--color-voi-orange);
		color: var(--color-voi-black);
	}

	.carousel-btn:active {
		background: var(--color-voi-black);
		color: var(--color-voi-white);
		scale: 0.9;
		transition: scale 0.1s ease-in-out;
	}

	.carousel-btn__icon {
		width: 10px;
		height: 16px;
	}

	.project-detail-panel {
		overflow: visible;
	}

	.project-carousel [data-detail] {
		opacity: 1;
	}
</style>
<script>
	import gsap from 'gsap';
	import { Flip } from 'gsap/Flip';
	import {
		forwardOffset,
		hiddenSnapTarget,
		resolveSlideSlot,
	} from '../lib/carousel-slots';

	gsap.registerPlugin(Flip);

	function wrapIndex(index: number, count: number) {
		return ((index % count) + count) % count;
	}

	const COLLAPSED_ROWS = 6;
	const STAGE_AND_META_ROWS = 5;
	const PHASE_DURATION = 0.32;
	const FADE_DURATION = 0.16;
	const NAV_DURATION = 0.4;
	const DRAG_SETTLE = 0.25;
	const EXPAND_EASE = 'power3.out';
	/** Close: softer inOut + slightly longer narrow reads as one continuous motion. */
	const CLOSE_EASE = 'power2.inOut';
	const DISMISS_DURATION = 0.22;
	const NARROW_DURATION = 0.42;
	const PANEL_CLIP_CLOSED = 'inset(0 0 100% 0)';
	const PANEL_CLIP_OPEN = 'inset(0 0 0 0)';
	const DRAG_THRESHOLD_PX = 64;
	const DRAG_MAX_PX = 96; // hard visual cap — keeps Flip from starting far off-cell
	const DRAG_VELOCITY = 0.45; // px/ms — flick to advance
	const DRAG_LOCK_PX = 8;
	const RESIZE_DEBOUNCE = 0.1; // seconds — gsap.delayedCall

	/** Map pointer delta to a bounded slide offset (asymptotic soft clamp). */
	function clampDragOffset(dx: number) {
		return Math.tanh(dx / DRAG_MAX_PX) * DRAG_MAX_PX;
	}

	function activeDetailRows(detail: HTMLElement | undefined) {
		if (!detail) return 6;
		const article = detail.querySelector<HTMLElement>('[data-row-span]');
		if (!article) return 6;
		const mobile = window.matchMedia('(max-width: 1023px)').matches;
		const key = mobile ? 'rowSpanMobile' : 'rowSpan';
		const raw = article.dataset[key] || article.dataset.rowSpan || '6';
		const declared = Number(raw) || 6;

		const height = article.scrollHeight;
		if (!height) return declared;

		const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
		const row = 11 * rem;
		const gap = 1 * rem;
		const measured = Math.ceil((height + gap) / (row + gap));
		return Math.max(declared, measured);
	}

	function initCarousel(root: HTMLElement) {
		// boot() runs at module eval AND on astro:page-load (which also fires on
		// first load) — a second init would duplicate listeners and kill in-flight Flips.
		if (root.dataset.carouselInit === 'true') return;
		root.dataset.carouselInit = 'true';

		const count = Number(root.dataset.count || 0);
		if (!count) return;

		const collapsedRows = Number(root.dataset.collapsedRows || COLLAPSED_ROWS);
		const stageRows = Number(root.dataset.stageRows || STAGE_AND_META_ROWS);

		const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
		const metas = [...root.querySelectorAll<HTMLElement>('[data-meta]')];
		const details = [...root.querySelectorAll<HTMLElement>('[data-detail]')];
		const stage = root.querySelector<HTMLElement>('.carousel-stage');
		const metaBar = root.querySelector<HTMLElement>('.carousel-meta');
		const controls = root.querySelector<HTMLElement>('[data-carousel-controls]');
		const panel = root.querySelector<HTMLElement>('[data-detail-panel]');
		const toggle = root.querySelector<HTMLButtonElement>('[data-carousel-toggle]');
		const ctaLabel = root.querySelector<HTMLElement>('[data-cta-label]');
		const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
		const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
		const main = document.querySelector('main');
		const brand = document.querySelector<HTMLElement>('[data-site-brand]');

		const STORAGE_KEY = 'voi-carousel';

		function isDetalleFlag(value: string | null) {
			return value === '1' || value === 'true';
		}

		function readStoredCarousel() {
			try {
				const raw = sessionStorage.getItem(STORAGE_KEY);
				return raw ? (JSON.parse(raw) as { proyecto?: string; detalle?: boolean }) : null;
			} catch {
				return null;
			}
		}

		function writeStoredCarousel(proyecto: string | undefined, detalle: boolean) {
			try {
				sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ proyecto, detalle }));
			} catch {
				/* private mode */
			}
		}

		function readClientState() {
			const params = new URLSearchParams(window.location.search);
			const hasUrlState = params.has('proyecto') || params.has('detalle');
			const stored = hasUrlState ? null : readStoredCarousel();
			const proyecto = params.get('proyecto') ?? stored?.proyecto ?? undefined;
			const expanded = hasUrlState
				? isDetalleFlag(params.get('detalle'))
				: Boolean(stored?.detalle);
			const fromId = details.findIndex((item) => item.dataset.id === proyecto);
			return {
				activeIndex: fromId >= 0 ? fromId : 0,
				expanded,
				restoredFromStorage: Boolean(stored && !hasUrlState),
			};
		}

		const initialState = readClientState();
		let active = initialState.activeIndex;
		let expanded = initialState.expanded;

		let dragPointerId: number | null = null;
		let dragStartX = 0;
		let dragStartY = 0;
		let dragLastX = 0;
		let dragLastT = 0;
		let dragVelocity = 0;
		let dragAxis: 'x' | 'y' | null = null;
		let dragActive = false;
		let expandTimeline: gsap.core.Timeline | null = null;
		let resizeCall: gsap.core.Tween | null = null;

		function setPanelClip(value: string) {
			if (panel) panel.style.clipPath = value;
		}

		function clearPanelClip() {
			panel?.style.removeProperty('clip-path');
		}

		function activeDetailEl() {
			return details.find((item) => Number(item.dataset.index) === active);
		}

		function setDetailAlpha(value: number) {
			const detail = activeDetailEl();
			if (detail) gsap.set(detail, { autoAlpha: value });
		}

		function clearDetailAlpha() {
			for (const detail of details) {
				gsap.set(detail, { clearProps: 'opacity,visibility' });
			}
		}

		function clearFlipTransforms() {
			gsap.set(slides, { clearProps: 'transform' });
			// Meta stays in grid flow (no Flip.absolute). Clear leftover absolute
			// props so a killed tween cannot pin it off-cell.
			if (metaBar) {
				gsap.set(metaBar, {
					clearProps: 'transform,position,width,height,top,left,right,bottom,margin',
				});
			}
			// Controls never use Flip absolute — only x. Clear any leftover absolute
			// props from earlier experiments so the grid cell stays intact.
			if (controls) {
				gsap.set(controls, {
					clearProps: 'transform,position,width,height,top,left,right,bottom,margin',
				});
			}
		}

		function slideFlipTween(
			state: Flip.FlipState | null,
			vars?: { duration?: number; ease?: string },
		) {
			if (!state) return null;
			return Flip.from(state, {
				duration: vars?.duration ?? PHASE_DURATION,
				ease: vars?.ease ?? EXPAND_EASE,
				absolute: true,
				nested: true,
				prune: true,
				// width/height (not scale) so object-fit re-crops mid-flight
				scale: false,
				props: 'opacity',
			});
		}

		function metaFlipTween(
			state: Flip.FlipState | null,
			vars?: { duration?: number; ease?: string },
		) {
			if (!state || !metaBar) return null;
			return Flip.from(state, {
				duration: vars?.duration ?? PHASE_DURATION,
				ease: vars?.ease ?? EXPAND_EASE,
				// Keep the bar in grid flow — absolute Flip was leaving it offset
				// or covered after expand/collapse, especially on narrow viewports.
				absolute: false,
				nested: false,
				scale: false,
			});
		}

		/**
		 * Move controls with x only — stays in grid flow.
		 * Flip.absolute would pull them out of the row and collapse layout.
		 * Call AFTER the grid-column mutation; pass left from before the change.
		 */
		function controlsMoveTween(
			fromLeft: number,
			vars?: { duration?: number; ease?: string },
		) {
			if (!controls) return null;
			const dx = fromLeft - controls.getBoundingClientRect().left;
			if (Math.abs(dx) < 0.5) return null;
			gsap.set(controls, { x: dx });
			return gsap.to(controls, {
				x: 0,
				duration: vars?.duration ?? PHASE_DURATION,
				ease: vars?.ease ?? EXPAND_EASE,
				clearProps: 'transform',
			});
		}

		function applyExpandedChrome(isExpanded: boolean) {
			root.dataset.expanded = isExpanded ? 'true' : 'false';
			root.dataset.metaFill = isExpanded ? 'true' : 'false';
			if (toggle) toggle.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
			if (ctaLabel) {
				ctaLabel.textContent = isExpanded ? 'OCULTAR DETALLE' : 'VER DETALLE';
			}
			main?.classList.toggle('is-expanded', isExpanded);

			const theme = isExpanded
				? slides[active]?.dataset.navTheme || 'dark'
				: 'dark';
			brand?.setAttribute('data-nav-theme', theme);
		}

		function setMetaFill(on: boolean) {
			root.dataset.metaFill = on ? 'true' : 'false';
		}

		function clearMetaFillProps() {
			if (metaBar) gsap.set(metaBar, { clearProps: 'backgroundColor' });
		}

		function syncRowSpans(options?: {
			panelRows?: number;
			retainLayout?: boolean;
			/** Override `expanded` when settling mid-toggle (openDetail baseline). */
			layout?: 'collapsed' | 'expanded';
		}) {
			const detail = details.find((item) => Number(item.dataset.index) === active);
			const detailRows = activeDetailRows(detail);
			const layout = options?.layout ?? (expanded ? 'expanded' : 'collapsed');
			const panelRows =
				options?.panelRows !== undefined
					? options.panelRows
					: layout === 'expanded'
						? detailRows
						: 0;
			const totalRows = options?.retainLayout
				? stageRows + detailRows
				: layout === 'expanded'
					? stageRows + panelRows
					: collapsedRows;

			root.style.gridRow = `1 / span ${totalRows}`;

			if (panel) {
				panel.style.gridRow = panelRows > 0 ? `span ${panelRows}` : '';
			}

			for (const item of details) {
				const isActive = Number(item.dataset.index) === active;
				const rows = isActive ? detailRows : 0;
				const showDetail = isActive && panelRows > 0;
				item.style.gridRow = showDetail ? `span ${rows}` : '';
				const article = item.querySelector<HTMLElement>('[data-row-span]');
				if (article) {
					article.style.gridRow = showDetail ? `span ${rows}` : '';
				}
			}
		}

		/** Pure kill — no DOM settle. Callers reset explicitly. */
		function killExpandAnimations() {
			expandTimeline?.kill();
			expandTimeline = null;
			Flip.killFlipsOf(slides, true);
			if (metaBar) Flip.killFlipsOf(metaBar, true);
			if (controls) gsap.killTweensOf(controls);
			if (metaBar) gsap.killTweensOf(metaBar, 'backgroundColor');
			if (panel) gsap.killTweensOf(panel, 'clipPath');
			for (const detail of details) gsap.killTweensOf(detail, 'opacity,visibility');
			clearFlipTransforms();
			clearMetaFillProps();
		}

		function settleExpandedUi() {
			applyExpandedChrome(true);
			if (panel) panel.hidden = false;
			syncRowSpans({ layout: 'expanded' });
			clearPanelClip();
			clearDetailAlpha();
		}

		function settleCollapsedUi() {
			applyExpandedChrome(false);
			if (panel) panel.hidden = true;
			syncRowSpans({ panelRows: 0, layout: 'collapsed' });
			clearPanelClip();
			clearDetailAlpha();
		}

		/**
		 * OPEN — single timeline.
		 * Contract: Flip.getState → mutate DOM → Flip.from, all synchronous
		 * before play. Phases: widen → grow → reveal.
		 */
		function openDetail() {
			killExpandAnimations();
			settleCollapsedUi();

			const slideState = Flip.getState(slides, { props: 'opacity' });
			const metaState = metaBar ? Flip.getState(metaBar) : null;
			const controlsLeft = controls?.getBoundingClientRect().left ?? 0;

			applyExpandedChrome(true);
			if (panel) panel.hidden = true;
			// Expanded width, no panel rows yet (widen phase)
			syncRowSpans({ panelRows: 0, layout: 'expanded' });
			setDetailAlpha(0);

			const tl = gsap.timeline({
				defaults: { duration: PHASE_DURATION, ease: EXPAND_EASE },
				onComplete: () => {
					clearPanelClip();
					clearDetailAlpha();
					clearFlipTransforms();
					expandTimeline = null;
				},
			});

			tl.addLabel('widen', 0);
			const widenSlide = slideFlipTween(slideState);
			const widenMeta = metaFlipTween(metaState);
			const widenControls = controlsMoveTween(controlsLeft);
			if (widenSlide) tl.add(widenSlide, 'widen');
			if (widenMeta) tl.add(widenMeta, 'widen');
			if (widenControls) tl.add(widenControls, 'widen');

			tl.addLabel('grow', '>');
			tl.call(
				() => {
					if (!panel) return;
					panel.hidden = false;
					syncRowSpans();
					setPanelClip(PANEL_CLIP_CLOSED);
					setDetailAlpha(0);
				},
				undefined,
				'grow',
			);
			if (panel) {
				tl.to(panel, { clipPath: PANEL_CLIP_OPEN }, 'grow');
			}

			// Start reveal before grow finishes — shorter perceived open
			tl.addLabel('reveal', `-=${FADE_DURATION * 0.5}`);
			const detail = activeDetailEl();
			if (detail) {
				tl.to(detail, { autoAlpha: 1, duration: FADE_DURATION }, 'reveal');
			}

			expandTimeline = tl;
		}

		/**
		 * CLOSE — two timelines with explicit handoff.
		 * Phase 1 (dismiss): content + clip + meta fill.
		 * Phase 2 (narrow): capture Flip AFTER dismiss mutates, then width Flip.
		 * Never inject Flip.from into a running timeline.
		 */
		function closeDetail() {
			killExpandAnimations();

			const detail = activeDetailEl();
			const detailRows = activeDetailRows(detail);

			// Keep expanded WIDTH while dismissing fill + detail shell
			root.dataset.expanded = 'true';
			setMetaFill(true);
			if (metaBar) {
				gsap.set(metaBar, { backgroundColor: 'var(--color-voi-white)' });
			}
			if (panel && !panel.hidden) {
				syncRowSpans({ panelRows: detailRows, retainLayout: true });
			} else {
				syncRowSpans({ panelRows: 0, retainLayout: true });
			}

			const dismissTl = gsap.timeline({
				defaults: { duration: DISMISS_DURATION, ease: CLOSE_EASE },
				onComplete: startNarrow,
			});

			dismissTl.addLabel('dismiss', 0);

			// Content leaves first; clip + meta share the dismiss window
			if (detail) {
				dismissTl.to(
					detail,
					{ autoAlpha: 0, duration: FADE_DURATION, ease: 'power2.in' },
					'dismiss',
				);
			}

			if (panel && !panel.hidden) {
				dismissTl.fromTo(
					panel,
					{ clipPath: PANEL_CLIP_OPEN },
					{ clipPath: PANEL_CLIP_CLOSED },
					'dismiss',
				);
			}

			if (metaBar) {
				dismissTl.to(
					metaBar,
					{
						backgroundColor: 'rgba(250, 250, 250, 0)',
						onComplete: () => {
							setMetaFill(false);
							clearMetaFillProps();
						},
					},
					'dismiss',
				);
			}

			expandTimeline = dismissTl;
		}

		function startNarrow() {
			// Synchronous Flip window — capture, mutate, Flip.from
			const slideState = Flip.getState(slides, { props: 'opacity' });
			const metaState = metaBar ? Flip.getState(metaBar) : null;
			const controlsLeft = controls?.getBoundingClientRect().left ?? 0;

			if (panel) panel.hidden = true;
			clearPanelClip();
			clearDetailAlpha();
			clearMetaFillProps();
			applyExpandedChrome(false);
			syncRowSpans({ panelRows: 0, layout: 'collapsed' });

			const flipVars = { duration: NARROW_DURATION, ease: CLOSE_EASE };
			const narrowTl = gsap.timeline({
				defaults: flipVars,
				onComplete: () => {
					clearFlipTransforms();
					expandTimeline = null;
				},
			});

			const narrowSlide = slideFlipTween(slideState, flipVars);
			const narrowMeta = metaFlipTween(metaState, flipVars);
			const narrowControls = controlsMoveTween(controlsLeft, flipVars);
			if (narrowSlide) narrowTl.add(narrowSlide, 0);
			if (narrowMeta) narrowTl.add(narrowMeta, 0);
			if (narrowControls) narrowTl.add(narrowControls, 0);

			expandTimeline = narrowTl;
		}

		/** Navigate slots only — never opens/closes the detail panel. */
		function navigate(direction: 'init' | 'next' | 'prev' = 'init') {
			const previousActive =
				direction === 'next'
					? wrapIndex(active - 1, count)
					: direction === 'prev'
						? wrapIndex(active + 1, count)
						: active;

			const animate = direction !== 'init';

			// Settle any in-flight expand/collapse to the current flag
			if (expandTimeline) {
				killExpandAnimations();
				if (expanded) settleExpandedUi();
				else settleCollapsedUi();
			}

			if (animate) {
				Flip.killFlipsOf(slides, true);
				gsap.set(slides, { clearProps: 'transform' });
			}

			const nextSlots = new Map<HTMLElement, string>();
			let didSnap = false;

			for (const slide of slides) {
				const index = Number(slide.dataset.index);
				const prevSlot =
					slide.dataset.slot ||
					resolveSlideSlot(index, previousActive, count, undefined, 'init');
				const nextSlot = resolveSlideSlot(index, active, count, prevSlot, direction);
				nextSlots.set(slide, nextSlot);

				// Wrong-side buffer: relocate instantly while invisible, before measuring.
				const snapTarget = hiddenSnapTarget(prevSlot, nextSlot);
				if (snapTarget) {
					slide.dataset.slot = snapTarget;
					didSnap = true;
				}
			}

			// Flush layout so getState sees the parked side (CSS translate ±120%).
			if (didSnap) void stage?.offsetWidth;

			const state = animate ? Flip.getState(slides, { props: 'opacity' }) : null;
			gsap.set(slides, { x: 0 });

			for (const slide of slides) {
				slide.dataset.slot = nextSlots.get(slide) || 'hidden-right';
				slide.dataset.forward = String(
					forwardOffset(Number(slide.dataset.index), active, count),
				);
			}

			for (const meta of metas) {
				meta.hidden = Number(meta.dataset.index) !== active;
			}

			for (const detail of details) {
				detail.hidden = Number(detail.dataset.index) !== active;
			}

			applyExpandedChrome(expanded);
			if (panel) panel.hidden = !expanded;
			syncRowSpans();
			if (expanded) clearDetailAlpha();

			if (state) {
				Flip.from(state, {
					duration: NAV_DURATION,
					ease: EXPAND_EASE,
					absolute: true,
					nested: true,
					prune: true,
					scale: false,
					props: 'opacity',
					onComplete: () => {
						// Free buffers so CSS `translate` parking can take over again.
						gsap.set(slides, { clearProps: 'transform' });
					},
				});
			}
		}

		function goPrev() {
			active = wrapIndex(active - 1, count);
			navigate('prev');
			syncUrl();
		}

		function goNext() {
			active = wrapIndex(active + 1, count);
			navigate('next');
			syncUrl();
		}

		function syncUrl() {
			const url = new URL(window.location.href);
			const id = details.find((item) => Number(item.dataset.index) === active)?.dataset.id;
			if (id) url.searchParams.set('proyecto', id);
			else url.searchParams.delete('proyecto');
			if (expanded) url.searchParams.set('detalle', '1');
			else url.searchParams.delete('detalle');
			writeStoredCarousel(id, expanded);
			if (url.href !== window.location.href) {
				history.replaceState(history.state, '', url);
			}
		}

		function endDrag(commit: boolean) {
			if (!stage) return;
			stage.classList.remove('is-dragging');
			dragActive = false;
			dragPointerId = null;
			dragAxis = null;

			if (!commit) {
				gsap.to(slides, {
					x: 0,
					duration: DRAG_SETTLE,
					ease: EXPAND_EASE,
					overwrite: true,
				});
				return;
			}

			const dx = clampDragOffset(dragLastX - dragStartX);
			const flickedNext = dragVelocity < -DRAG_VELOCITY;
			const flickedPrev = dragVelocity > DRAG_VELOCITY;
			const draggedNext = dx < -DRAG_THRESHOLD_PX;
			const draggedPrev = dx > DRAG_THRESHOLD_PX;

			if (flickedNext || draggedNext) goNext();
			else if (flickedPrev || draggedPrev) goPrev();
			else {
				gsap.to(slides, {
					x: 0,
					duration: DRAG_SETTLE,
					ease: EXPAND_EASE,
					overwrite: true,
				});
			}
		}

		prev?.addEventListener('click', goPrev);
		next?.addEventListener('click', goNext);

		toggle?.addEventListener('click', () => {
			if (expanded) {
				expanded = false;
				closeDetail();
			} else {
				expanded = true;
				openDetail();
			}
			syncUrl();
		});

		stage?.addEventListener('pointerdown', (event) => {
			if (event.button !== 0) return;
			if ((event.target as Element | null)?.closest?.('button, a')) return;

			Flip.killFlipsOf(slides, true);
			gsap.killTweensOf(slides);
			gsap.set(slides, { x: 0 });

			dragPointerId = event.pointerId;
			dragStartX = event.clientX;
			dragStartY = event.clientY;
			dragLastX = event.clientX;
			dragLastT = performance.now();
			dragVelocity = 0;
			dragAxis = null;
			dragActive = true;
			stage.setPointerCapture(event.pointerId);
		});

		stage?.addEventListener('pointermove', (event) => {
			if (!dragActive || event.pointerId !== dragPointerId) return;

			const dx = event.clientX - dragStartX;
			const dy = event.clientY - dragStartY;

			if (!dragAxis) {
				if (Math.abs(dx) < DRAG_LOCK_PX && Math.abs(dy) < DRAG_LOCK_PX) return;
				dragAxis = Math.abs(dx) >= Math.abs(dy) ? 'x' : 'y';
				if (dragAxis === 'y') {
					// Let the page scroll; abandon the gesture.
					dragActive = false;
					dragPointerId = null;
					try {
						stage.releasePointerCapture(event.pointerId);
					} catch {
						/* already released */
					}
					return;
				}
				stage.classList.add('is-dragging');
			}

			if (dragAxis !== 'x') return;
			event.preventDefault();

			const now = performance.now();
			const dt = now - dragLastT;
			if (dt > 0) dragVelocity = (event.clientX - dragLastX) / dt;
			dragLastX = event.clientX;
			dragLastT = now;

			gsap.set(slides, { x: clampDragOffset(dx) });
		});

		stage?.addEventListener('pointerup', (event) => {
			if (event.pointerId !== dragPointerId) return;
			const wasHorizontal = dragAxis === 'x';
			endDrag(wasHorizontal);
		});

		stage?.addEventListener('pointercancel', (event) => {
			if (event.pointerId !== dragPointerId) return;
			endDrag(false);
		});

		window.addEventListener('resize', () => {
			resizeCall?.kill();
			resizeCall = gsap.delayedCall(RESIZE_DEBOUNCE, () => {
				killExpandAnimations();
				clearFlipTransforms();
				clearPanelClip();
				clearDetailAlpha();
				if (expanded) settleExpandedUi();
				else settleCollapsedUi();
			});
		});

		navigate('init');
		if (expanded) settleExpandedUi();
		if (initialState.restoredFromStorage) syncUrl();
	}

	function boot() {
		document.querySelectorAll<HTMLElement>('[data-project-carousel]').forEach(initCarousel);
	}

	boot();
	document.addEventListener('astro:page-load', boot);
</script>

---
import { Image } from 'astro:assets';
import g01 from '../../content/proyectos/berazategui/g-01.jpg';
import g02 from '../../content/proyectos/berazategui/g-02.jpg';
import g03 from '../../content/proyectos/berazategui/g-03.jpg';
import g04 from '../../content/proyectos/berazategui/g-04.jpg';
import g05 from '../../content/proyectos/berazategui/g-05.jpg';
import g06 from '../../content/proyectos/berazategui/g-06.jpg';
import g07 from '../../content/proyectos/berazategui/g-07.jpg';
import g08 from '../../content/proyectos/berazategui/g-08.jpg';
---

<article
	class="project-detail col-span-full grid grid-cols-subgrid grid-rows-subgrid"
	data-row-span="6"
	data-row-span-mobile="10"
>
	<div class="col-span-full row-span-1 font-libertad-mono text-lg leading-relaxed text-voi-black lg:col-span-3 lg:col-start-2">
		<p>Proyecto y obra en Berazategui, Buenos Aires.</p>
	</div>

	<figure class="m-0 col-span-full row-span-1 overflow-hidden lg:col-span-3 lg:col-start-5">
		<Image
			src={g01}
			alt=""
			widths={[496, 752, 1009]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure class="m-0 col-span-full row-span-1 overflow-hidden lg:col-span-4 lg:col-start-1">
		<Image
			src={g02}
			alt=""
			widths={[752, 1009, 1400]}
			sizes="(max-width: 1024px) 100vw, 58vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure class="m-0 col-span-full row-span-1 overflow-hidden lg:col-span-3 lg:col-start-5">
		<Image
			src={g03}
			alt=""
			widths={[496, 752, 1009]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure class="m-0 col-span-1 row-span-1 overflow-hidden lg:col-span-2 lg:col-start-1">
		<Image
			src={g04}
			alt=""
			widths={[320, 496]}
			sizes="(max-width: 1024px) 50vw, 22vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure class="m-0 col-span-1 row-span-1 overflow-hidden lg:col-span-2 lg:col-start-3">
		<Image
			src={g05}
			alt=""
			widths={[320, 496]}
			sizes="(max-width: 1024px) 50vw, 22vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure class="m-0 col-span-full row-span-2 overflow-hidden lg:col-span-3 lg:col-start-5">
		<Image
			src={g06}
			alt=""
			widths={[496, 752]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure class="m-0 col-span-full row-span-1 overflow-hidden lg:col-span-3 lg:col-start-5">
		<Image
			src={g07}
			alt=""
			widths={[496, 752]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure class="m-0 col-span-full row-span-1 overflow-hidden lg:col-span-3 lg:col-start-5">
		<Image
			src={g08}
			alt=""
			widths={[496, 752]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>
</article>

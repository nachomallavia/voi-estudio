---
import { Image } from 'astro:assets';
import g01 from '../../content/proyectos/escobar/g-01.jpg';
import g02 from '../../content/proyectos/escobar/g-02.jpg';
import g03 from '../../content/proyectos/escobar/g-03.jpg';
import g04 from '../../content/proyectos/escobar/g-04.jpg';
import g05 from '../../content/proyectos/escobar/g-05.jpg';
import g06 from '../../content/proyectos/escobar/g-06.jpg';
import g07 from '../../content/proyectos/escobar/g-07.jpg';
import g08 from '../../content/proyectos/escobar/g-08.jpg';

import escobar01 from '../../assets/obras/escobar/· San Matías · (2).jpg'
import escobar02 from '../../assets/obras/escobar/· San Matías · (28).jpg'
import escobar03 from '../../assets/obras/escobar/· San Matías · (47).jpg'
import escobar04 from '../../assets/obras/escobar/· San Matías · (75).jpg'
import escobar05 from '../../assets/obras/escobar/· San Matías · (53).jpg'
---

<article
	class="project-detail col-span-full grid grid-cols-subgrid grid-rows-subgrid bg-voi-white"
	data-row-span="4"
	data-row-span-mobile="19"
>
	<div class="col-span-full row-span-3 lg:row-span-2 flex flex-col gap-5 px-5 pt-15 font-libertad-mono text-base text-pretty leading-normal text-voi-black lg:col-span-3 lg:col-start-1 border-b border-voi-orange lg:pr-20">
		<p class="text-justify">
			La vivienda contemplaba la necesidad de una familia habitando en fin de semana, por ello era
			importante el bajo mantenimiento de los materiales, utilizando hormigón, ladrillo y herrería
			oscura.		
		</p>
		<p class="text-justify">
			Por otro lado el confort con la mayor versatilidad de los espacios y en tiempos, por ello se
			enfatizó la orientación norte, con aleros y regulación de aberturas, para su buen uso en
			verano e invierno.
		</p>
	</div>

	<figure class="m-0 col-span-full row-span-2 overflow-hidden lg:col-span-3 lg:col-start-4">
		<Image
			src={escobar01}
			alt=""
			widths={[496, 752, 1009]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>
	<div class="col-span-full row-span-1 min-h-44 bg-voi-orange"></div>

	<figure class="m-0 col-span-full row-span-2 overflow-hidden lg:col-span-4 lg:col-start-1">
		<Image
			src={escobar03}
			alt=""
			widths={[752, 1009, 1400]}
			sizes="(max-width: 1024px) 100vw, 58vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure class="m-0 col-span-full row-span-2 overflow-hidden lg:col-span-3 lg:col-start-5">
		<Image
			src={escobar02}
			alt=""
			widths={[496, 752, 1009]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure class="m-0 col-span-2 row-span-2 overflow-hidden lg:col-span-2 lg:col-start-1">
		<Image
			src={escobar05}
			alt=""
			widths={[320, 496]}
			sizes="(max-width: 1024px) 50vw, 22vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure class="m-0 col-span-2 row-span-2 overflow-hidden lg:col-span-3 lg:col-start-3">
		<Image
			src={escobar04}
			alt=""
			widths={[320, 496]}
			sizes="(max-width: 1024px) 50vw, 22vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	

	<div class="col-span-full row-span-2 grid grid-cols-subgrid lg:col-span-4 lg:col-start-1">
		<div class="col-span-1 lg:col-span-2 px-5">
			<h3 class="mb-2 font-libertad-mono text-lg text-voi-black">Tipología</h3>
			<p class="text-sm text-pretty leading-normal text-voi-black/90">
				Vivienda 1× · 272 m². Pensada para una familia en fin de semana, con bajo mantenimiento y
				espacios versátiles.
			</p>
		</div>
		<div class="col-span-1 lg:col-span-2 px-5">
			<h3 class="mb-2 font-libertad-mono text-lg text-voi-black">Materiales</h3>
			<p class="text-sm text-pretty leading-normal text-voi-black/90">
				Hormigón, ladrillo y herrería oscura, con orientación norte, aleros y regulación de
				aberturas.
			</p>
		</div>
	</div>

	<div class=" px-5 col-span-full row-span-3 grid grid-cols-subgrid grid-rows-subgrid lg:row-span-2  ">
		<div class=" bg-voi-orange col-span-1 row-span-1 md:col-span-2 md:row-span-2 " aria-hidden="true"></div>
		<blockquote class="z-10  font-libertad-mono text-voi-black col-span-full md:col-span-3 flex flex-col justify-start lg:justify-center row-span-2">
			<p class=" text-2xl md:text-3xl text-pretty leading-snug">
				“La vivienda contemplaba la necesidad de una familia habitando en fin de semana.”
			</p>
			<footer class="mt-4 lg:mt-8 text-xl">VOI Estudio — proyecto y obra</footer>
		</blockquote>
	</div>

	<figure class="m-0 col-span-full row-span-3 overflow-hidden lg:col-span-3 lg:row-span-2 ">
		<Image
			src={g07}
			alt=""
			widths={[496, 752]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	
</article>

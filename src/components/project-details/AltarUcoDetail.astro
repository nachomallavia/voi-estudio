---
import { Image } from 'astro:assets';
import img01 from '../../assets/obras/altar-uco/01.jpg';
import img02 from '../../assets/obras/altar-uco/02.jpg';
import img03 from '../../assets/obras/altar-uco/03.jpg';
import img04 from '../../assets/obras/altar-uco/04.jpg';
import img05 from '../../assets/obras/altar-uco/05.jpg';
import img06 from '../../assets/obras/altar-uco/06.jpg';
import img07 from '../../assets/obras/altar-uco/07.jpg';
import img08 from '../../assets/obras/altar-uco/08.jpg';
---

<article
	class="project-detail col-span-full grid grid-cols-subgrid grid-rows-subgrid bg-voi-white"
	data-row-span="4"
	data-row-span-mobile="19"
>
	<div class="col-span-full row-span-3 lg:row-span-3 flex flex-col gap-5 px-5 pt-15 font-libertad-mono text-sm text-pretty leading-normal text-voi-black lg:col-span-3 lg:col-start-1 border-b border-voi-orange lg:pr-20">
		<h3 class="mb-2 font-libertad-mono text-xl text-voi-orange">UCO</h3>
		<p data-fade-up class="text-justify">
			Bodega Altar Uco se presenta con el gen de realizar una construcción que permita la producción del vino, pero también la idea de encontrarse en un espacio donde las sensaciones del usuario estén activas durante todo el periodo que se esté en el sitio.
		</p>
		<p data-fade-up class="text-justify">
			Para esto iniciamos un camino proyectual utilizando el descubrimiento que se genera cuando uno recorre el camino hacia la cordillera como idea rectora. La topografía genera los distintos niveles en el recorrido pudiendo recorrer los viñedos antes de llegar al edificio y rematando en el sector más alto del lote con el espacio de encuentro y acceso a la bodega, camino generando una transición entre la vegetación y la construcción.
		</p>
	</div>

	<figure data-fade-up class="m-0 col-span-full row-span-3 overflow-hidden lg:col-span-3 lg:col-start-4">
		<Image
			src={img01}
			alt=""
			widths={[496, 752, 1009]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>
	<div class="col-span-full row-span-1 min-h-44 bg-voi-orange"></div>

	<figure data-fade-up class="m-0 col-span-full row-span-2 overflow-hidden lg:col-span-3 lg:row-span-3 lg:col-start-1">
		<Image
			src={img03}
			alt=""
			widths={[752, 1009, 1400]}
			sizes="(max-width: 1024px) 100vw, 58vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure data-fade-up class="m-0 col-span-full row-span-2 overflow-hidden lg:col-span-2 lg:row-span-3 ">
		<Image
			src={img02}
			alt=""
			widths={[496, 752, 1009]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure data-fade-up class="m-0 col-span-2 row-span-2 overflow-hidden lg:col-span-2 lg:col-start-1">
		<Image
			src={img05}
			alt=""
			widths={[320, 496]}
			sizes="(max-width: 1024px) 50vw, 22vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure data-fade-up class="m-0 col-span-2 row-span-2 overflow-hidden lg:col-span-3 lg:col-start-3">
		<Image
			src={img04}
			alt=""
			widths={[320, 496]}
			sizes="(max-width: 1024px) 50vw, 22vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<div class="col-span-full row-span-2 grid grid-cols-subgrid lg:col-span-4 lg:col-start-1">
		<div data-fade-up class="col-span-1 lg:col-span-2 px-5">
			<h3 class="mb-2 font-libertad-mono text-lg text-voi-black">Tipología</h3>
			<p class="text-sm text-pretty leading-normal text-voi-black/90">
				Bodega · 540 m². Edificio productivo con guarda y degustación junto a los viñedos.
			</p>
		</div>
		<div data-fade-up class="col-span-1 lg:col-span-2 px-5">
			<h3 class="mb-2 font-libertad-mono text-lg text-voi-black">Sitio</h3>
			<p class="text-sm text-pretty leading-normal text-voi-black/90">
				en la bodega se propuso su mayor orientación hacia el Cordón del Plata, este sector con relación hacia el paisaje tiene su opuesto hacia el área donde se realiza la creación del vino y por ende genera un fuelle entre la naturaleza y la creación.
			</p>
		</div>
	</div>

	<!-- <div class=" px-5 col-span-full row-span-3 grid grid-cols-subgrid grid-rows-subgrid lg:row-span-3  ">
		<div class=" bg-voi-orange col-span-1 row-span-1 md:col-span-2 md:row-span-2 " aria-hidden="true"></div>
		<blockquote data-fade-up class="z-10  font-libertad-mono text-voi-black col-span-full md:col-span-3 flex flex-col justify-start lg:justify-center row-span-2">
			<p class=" text-2xl md:text-3xl text-pretty leading-snug">
				“Se acrecentó el peso de los materiales para la relación con el vino y para la relación con el sitio.”
			</p>
			<footer class="mt-4 lg:mt-8 text-xl">VOI Estudio — proyecto y obra</footer>
		</blockquote>
	</div> -->

	<figure data-fade-up class="m-0 col-span-full row-span-3 overflow-hidden lg:col-span-3 lg:row-span-2 ">
		<Image
			src={img06}
			alt=""
			widths={[496, 752]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>
	<figure data-fade-up class="m-0 col-span-full row-span-3 overflow-hidden lg:col-span-2 lg:row-span-2 ">
		<Image
			src={img07}
			alt=""
			widths={[496, 752]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>
	<figure data-fade-up class="m-0 col-span-full row-span-3 overflow-hidden lg:col-span-full lg:row-span-3 ">
		<Image
			src={img08}
			alt=""
			widths={[496, 752]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>
</article>

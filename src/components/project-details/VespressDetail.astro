---
import { Image } from 'astro:assets';
import img01 from '../../assets/obras/vespress/01.jpg';
import img02 from '../../assets/obras/vespress/02.jpg';
import img03 from '../../assets/obras/vespress/03.jpg';
import img04 from '../../assets/obras/vespress/04.jpg';
import img05 from '../../assets/obras/vespress/05.jpg';
import img06 from '../../assets/obras/vespress/06.jpg';
import img07 from '../../assets/obras/vespress/07.jpg';
import img08 from '../../assets/obras/vespress/08.jpg';
---

<article
	class="project-detail col-span-full grid grid-cols-subgrid grid-rows-subgrid bg-voi-white"
	data-row-span="4"
	data-row-span-mobile="19"
>
	<div class="col-span-full row-span-3 lg:row-span-2 flex flex-col gap-5 px-5 pt-15 font-libertad-mono text-base text-pretty leading-normal text-voi-black lg:col-span-3 lg:col-start-1 border-b border-voi-orange lg:pr-20">
		<p data-fade-up class="text-justify">
			El local se proyectó como una fábrica de cannoli a la calle: cocina productiva y mostrador de
			café en un mismo espacio. El verde menta de fachada e interior, junto a la herrería y las
			bandejas de instalación vistas, ordenan el uso comercial sin perder el carácter de taller.
		</p>
		<p data-fade-up class="text-justify">
			Hacia la vereda, el local se abre como vitrina y mostrador; hacia adentro, la cocina de
			acero y el bar azul articulan producción y servicio.
		</p>
	</div>

	<figure data-fade-up class="m-0 col-span-full row-span-2 overflow-hidden lg:col-span-3 lg:col-start-4">
		<Image
			src={img01}
			alt=""
			widths={[496, 752, 1009]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>
	<div class="col-span-full row-span-1 min-h-44 bg-voi-orange"></div>

	<figure data-fade-up class="m-0 col-span-full row-span-2 overflow-hidden lg:col-span-3 lg:row-span-3 lg:col-start-1">
		<Image
			src={img03}
			alt=""
			widths={[752, 1009, 1400]}
			sizes="(max-width: 1024px) 100vw, 58vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure data-fade-up class="m-0 col-span-full row-span-2 overflow-hidden lg:col-span-2 lg:row-span-3 ">
		<Image
			src={img02}
			alt=""
			widths={[496, 752, 1009]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure data-fade-up class="m-0 col-span-2 row-span-2 overflow-hidden lg:col-span-2 lg:col-start-1">
		<Image
			src={img05}
			alt=""
			widths={[320, 496]}
			sizes="(max-width: 1024px) 50vw, 22vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<figure data-fade-up class="m-0 col-span-2 row-span-2 overflow-hidden lg:col-span-3 lg:col-start-3">
		<Image
			src={img04}
			alt=""
			widths={[320, 496]}
			sizes="(max-width: 1024px) 50vw, 22vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>

	<div class="col-span-full row-span-1 grid grid-cols-subgrid lg:col-span-4 lg:col-start-1">
		<div data-fade-up class="col-span-1 lg:col-span-2 px-5">
			<h3 class="mb-2 font-libertad-mono text-lg text-voi-black">Tipología</h3>
			<p class="text-sm text-pretty leading-normal text-voi-black/90">
				Local comercial · Fabbrica di Cannoli. Cocina productiva y mostrador a la calle.
			</p>
		</div>
		<div data-fade-up class="col-span-1 lg:col-span-2 px-5">
			<h3 class="mb-2 font-libertad-mono text-lg text-voi-black">Materiales</h3>
			<p class="text-sm text-pretty leading-normal text-voi-black/90">
				Fachada verde menta, acero inoxidable, mostrador azul y bandejas de instalación vistas.
			</p>
		</div>
	</div>

	<div class=" px-5 col-span-full row-span-3 grid grid-cols-subgrid grid-rows-subgrid lg:row-span-3  ">
		<div class=" bg-voi-orange col-span-1 row-span-1 md:col-span-2 md:row-span-2 " aria-hidden="true"></div>
		<blockquote data-fade-up class="z-10  font-libertad-mono text-voi-black col-span-full md:col-span-3 flex flex-col justify-start lg:justify-center row-span-2">
			<p class=" text-2xl md:text-3xl text-pretty leading-snug">
				“El local se proyectó como una fábrica de cannoli a la calle.”
			</p>
			<footer class="mt-4 lg:mt-8 text-xl">VOI Estudio — proyecto y obra</footer>
		</blockquote>
	</div>

	<figure data-fade-up class="m-0 col-span-full row-span-3 overflow-hidden lg:col-span-3 lg:row-span-2 ">
		<Image
			src={img06}
			alt=""
			widths={[496, 752]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>
	<figure data-fade-up class="m-0 col-span-full row-span-3 overflow-hidden lg:col-span-2 lg:row-span-2 ">
		<Image
			src={img07}
			alt=""
			widths={[496, 752]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>
	<figure data-fade-up class="m-0 col-span-full row-span-3 overflow-hidden lg:col-span-full lg:row-span-3 ">
		<Image
			src={img08}
			alt=""
			widths={[496, 752]}
			sizes="(max-width: 1024px) 100vw, 40vw"
			class="h-full w-full object-cover"
			loading="lazy"
		/>
	</figure>
</article>

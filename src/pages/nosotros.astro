---
import Layout from '../layouts/Layout.astro';
import VoiOutline from '../assets/nosotros/voi-outline.svg';

const ecosistema = [
	{
		title: '01. El equipo',
		tag: 'Interno',
		body: 'Desde adentro del estudio, donde cada talento suma una perspectiva única y técnica para resolver el problema.',
	},
	{
		title: '02. Los socios',
		tag: 'Asesores',
		body: 'Constructores y proveedores que transforman la documentación técnica en realidad tangible. El conocimiento compartido reduce el error y potencia la innovación.',
	},
	{
		title: '03. El cliente',
		tag: 'Validación',
		body: 'El pilar fundamental. Sus necesidades operativas y deseos son el motor y la validación de cada trazo.',
	},
] as const;

const cita = [
	'Reflejamos la función a través de la precisión física.<br> No hay decisiones arbitrarias en nuestro proceso.',
	'El color, la forma, la textura y el material son la manifestación directa del sistema que estamos creando.<br>',
	'La estética es la consecuencia de un sistema diseñado.',
] as const;
---

<Layout bgColor="bg-voi-white">
	<div
		class="col-span-full row-[1/span_13] z-10 relative grid grid-cols-subgrid grid-rows-subgrid font-libertad-mono text-voi-black lg:row-[1/span_9]"
	>
		<section
			class="col-span-full row-[3/span_2] z-10 px-5 lg:col-span-3 lg:col-start-2 lg:px-0"
		>
			<div class="text-base leading-6 space-y-6 text-balance hidden md:block">
				<p data-fade-up>
					Nuestra identidad nace del reconocimiento del &ldquo;otro&rdquo;.
					<br> Es una palabra que nos recuerda que las mejores soluciones<br> no vienen de una sola dirección.
				</p>
				<p data-fade-up>
					Buscamos expandir la arquitectura enfocándonos en el cliente, <br> entendiendo su necesidad
					como punto de partida <br>para pdesarrollar un proyecto único.
				</p>
				<p data-fade-up>Nos adaptamos a la visión del otro aportando una mirada multidisciplinar.</p>
			</div>
			<div class="text-base leading-6 space-y-6 text-balance block lg:hidden">
				<p data-fade-up>
					Nuestra identidad nace del reconocimiento del &ldquo;otro&rdquo;.<br>
					Es una palabra que nos recuerda que las mejores soluciones no vienen de una sola dirección.
				</p>
				<p data-fade-up>
					Buscamos expandir la arquitectura enfocándonos en el cliente, entendiendo su necesidad
					como punto de partida para desarrollar un proyecto único.
				</p>
				<p data-fade-up>Nos adaptamos a la visión del otro aportando una mirada multidisciplinar.</p>
			</div>
		</section>

		<section
			class="col-span-full row-[6/span_4] relative z-10 px-5 pt-8 lg:col-span-2 lg:col-start-5 lg:row-[2/span_5] lg:px-0 lg:pt-8"
		>
			<div
				data-parallax="0.5"
				class="pointer-events-none absolute -right-8 top-0 hidden h-full w-[28rem] text-voi-grey lg:block"
				aria-hidden="true"
			>
				<VoiOutline
					class="absolute left-1/2 top-1/2 h-[42rem] w-auto max-w-none -translate-x-1/2 -translate-y-1/2 rotate-90 stroke-1 opacity-50"
				/>
			</div>

			<div class="relative z-10 flex flex-col gap-10 lg:gap-12">
				<h2 data-fade-up class="text-2xl leading-none uppercase">Ecosistema de trabajo</h2>
				{
					ecosistema.map(({ title, tag, body }) => (
						<article data-fade-up>
							<h3 class="text-lg leading-normal uppercase">{title}</h3>
							<p class="mt-2 text-sm uppercase">[ {tag} ]</p>
							<p class=" pt-2 text-base leading-normal text-balance">{body}</p>
						</article>
					))
				}
			</div>
		</section>

		<div class="col-span-1 row-span-2 row-start-3 col-start-7 hidden items-center justify-center lg:flex">
			<p
				class="pointer-events-none z-20 origin-center -rotate-90 whitespace-nowrap text-lg text-voi-black"
			>
				BUENOS AIRES, AR
			</p>
		</div>

		<blockquote
			class="col-span-full row-[9/span_4] z-10 mx-5 mb-20 bg-voi-orange flex items-center justify-center leading-6 lg:col-span-5 lg:col-start-2 lg:row-[6/span_2] lg:mx-0 lg:mb-16"
			data-parallax="0.2" >
			<div class="text-2xl space-y-4 mx-auto max-w-4xl px-8 py-8 md:px-8 md:py-8">
				{cita.map((paragraph) => <p set:html={paragraph} class="text-balance leading-8" />)}
			</div>
		</blockquote>
	</div>
</Layout>
